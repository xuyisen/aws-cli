#!/usr/bin/env python
"""
Run check-manifest to verify the project's MANIFEST.in is correct.

This script is used by CI to validate that all expected files are
included in the source distribution.
"""

import os
import sys
from subprocess import check_call

_dname = os.path.dirname

REPO_ROOT = _dname(_dname(_dname(os.path.abspath(__file__))))


def run(command):
    """Run a shell command and return its exit code."""
    return check_call(command, shell=True)


def main():
    """Run check-manifest from the repository root."""
    os.chdir(REPO_ROOT)
    run("check-manifest")


if __name__ == "__main__":
    main()
